# Copy this file to .env or SHIV_BOT/.env and fill the required values.
# Never commit BOT_TOKEN, API_HASH, cookies, or resolver keys.

BOT_TOKEN=
API_ID=
API_HASH=
ADMIN_IDS=
OWNER_ID=

# Optional force-join chats: @publicchannel or -1001234567890, comma-separated.
REQUIRED_CHATS=
SUPPORT_URL=
UPDATES_URL=
BOT_USERNAME=

DATABASE_PATH=data/shiv_deltatera.sqlite3
MAX_DOWNLOAD_BYTES=536870912
MAX_CONCURRENT_DOWNLOADS=2
MAX_URL_LENGTH=2048
MEDIA_AUTO_DELETE_MINUTES=5

# Leave empty to disable UPI plan buttons.
UPI_ID=
UPI_NAME=SHIV DeltaTera
QR_EXPIRY_MINUTES=10

# Your own/authorized resolver services. They receive {"url": "..."}.
TERABOX_API_URL=
TERABOX_API_KEY=
TERABOX_COOKIE=
DISKWALLA_API_URL=
DISKWALLA_API_KEY=
DISKWALLA_COOKIE=

LOG_CHAT_ID=
PAYMENT_LOG_CHAT_ID=
DATA_LOG_CHAT_ID=
WATERMARK_TEXT=SHIV DELTATERA
PRIVACY_URL=
LOG_FILE=data/shiv_deltatera.log
CUSTOM_EMOJI_IDS=